                "tool": "org.joget.apps.app.lib.WebCodingOverviewTool",
                "content": "<ul class=\"nav nav-tabs\" id=\"myTab\">\n  <li class=\"nav-item\" role=\"presentation\">\n    <button class=\"nav-link active\" id=\"form-tab\" data-bs-target=\"#welcomePage_forms\" type=\"button\" aria-controls=\"form-tab-pane\" aria-selected=\"true\">Forms<\/button>\n  <\/li>\n  <li class=\"nav-item\" role=\"presentation\">\n    <button class=\"nav-link\" id=\"list-tab\" data-bs-target=\"#welcomePage_list\" type=\"button\" aria-controls=\"list-tab-pane\" aria-selected=\"false\">List<\/button>\n  <\/li>\n  <li class=\"nav-item\" role=\"presentation\">\n    <button class=\"nav-link\" id=\"charts-tab\" data-bs-target=\"#welcomePage_chart\" type=\"button\" aria-controls=\"charts-tab-pane\" aria-selected=\"false\">Charts<\/button>\n  <\/li>\n  <li class=\"nav-item\" role=\"presentation\">\n    <button class=\"nav-link\" id=\"pageComponent-tab\" data-bs-target=\"#welcomePage_new\" type=\"button\" aria-controls=\"pageComponent-tab-pane\" aria-selected=\"false\">Component<\/button>\n  <\/li>\n<\/ul>\n<style>\n#welcome p{\n    direction: ltr;\n}\n#myTab{\n  padding-inline-start: 0px;\n  border-bottom: 0px;\n  margin-bottom: 0px;\n}\n#myTab .nav-item {\n    margin-bottom: -1px;\n    padding: 10px;\n    color: #5A83A5;\n}\n#myTab .nav-item:first-child {\n    padding-left: 0px;\n}\n#myTab .nav-link {\n    padding-bottom: 10px;\n  \tbackground-color: #fff;\n    border: 0px;\n  \tpadding-inline: 0px;\n  \tcolor: #003A70;\n    box-shadow: none;\n    border-radius: 0px;\n    font-weight: 500;\n  \tfont-size: 16px;\n}\n#myTab .nav-link.active {\n    border-bottom: 1px solid;\n\tcolor: #003A70;\n}\n#moreVideos{\n   border-left: 1px solid #EEF1F1;\n}\nbody.rtl #moreVideos{\n    border-right: 1px solid #EEF1F1;\n \tborder-left: 0px;\n}\n@media (max-width: 767px) {\n#moreVideos{\n   border-left: 0px !important;\n   border-right: 0px !important;\n}\n<\/style>\n<script>\n  $(document).ready(function () {\n  $('#myTab .nav-link').on('click', function () {\n    const targetId = $(this).data('bs-target');\n\n    // Hide all panes with fade\n    $('#welcomePage_forms, #welcomePage_list, #welcomePage_chart, #welcomePage_new')\n      .stop(true, true).fadeOut(200);\n\n    // Show target after a short delay (optional)\n    setTimeout(() => {\n      $(targetId).stop(true, true).fadeIn(200);\n    }, 200);\n\n    // Update active tab\n    $('#myTab .nav-link').removeClass('active');\n    $(this).addClass('active');\n  });\n\n  // Set initial visibility\n  $('#welcomePage_forms').show();\n  $('#welcomePage_list, #welcomePage_chart, #welcomePage_new').hide();\n\n  // Trigger default tab\n  $('#form-tab').click();\n});\n<\/script>"
